# FORGE API settings. Copy this file to ".env" and fill it in.
# ".env" is git-ignored. Never commit real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Leave empty in local development to use a private database on this machine.
MONGODB_URI=

# Database name inside the cluster. Keep this set: on a cluster shared with
# other projects, a connection without a database name falls through to "test".
MONGODB_DB=gym

# Long random string used to sign sessions. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The site address(es) allowed to call this API from a browser, comma-separated.
# Needed when hosted (the site and the API are on different addresses).
# Not needed locally: the dev site forwards /api to this server.
# Example: CORS_ORIGIN=https://demo-web-forge-gym.onrender.com
CORS_ORIGIN=

# ---- Payments (optional): Razorpay ---------------------------------------
# With TEST keys (rzp_test_...) the demo's payment links take a real Razorpay
# test payment. Live keys are ignored by the demo, so no real money can move.
# Leave both empty to keep the practice pay page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- WhatsApp (optional): Meta WhatsApp Cloud API -------------------------
# TOKEN and PHONE_NUMBER_ID are a test sender (Meta's free test number); they are
# not needed once your own number is connected at /admin/whatsapp.
# Demo messages are delivered ONLY to the phones
# listed in WHATSAPP_DEMO_RECIPIENTS (comma-separated, with country code, e.g.
# +919876543210), never to a number typed into the demo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEMO_RECIPIENTS=
# Both are needed for delivery updates (sent, delivered, read). APP_SECRET is the
# Meta app's secret; VERIFY_TOKEN is any phrase you choose and also type into Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# To send from your OWN WhatsApp Business app number (it keeps working in the
# app): the Meta app's id and the id of its "WhatsApp Embedded Signup"
# configuration. Both are public identifiers. WHATSAPP_APP_SECRET above is also
# required. The number is then connected on the site at /admin/whatsapp.
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=
# Unlocks /admin/whatsapp. Make up a long phrase (16+ characters) and keep it private.
ADMIN_KEY=
# Ceiling on real messages per day, so a public demo cannot flood the demo phone.
WHATSAPP_DAILY_LIMIT=50

# Optional
PORT=4000
SESSION_HOURS=12
DEMO_SANDBOX_TTL_HOURS=24
DEMO_MAX_SANDBOXES=200
