# FORGE site settings. Copy to ".env" only if you need to change a default.
# Everything here is public: it is built into the site. Secrets belong in
# ../forge-gym-backend/.env, never here.

# Address of the FORGE API (../forge-gym-backend) for a hosted site.
# Leave empty for local development: "npm run dev" forwards /api to the API.
# Example: VITE_API_URL=https://forge-gym-api.onrender.com
VITE_API_URL=

# Local development only: where "npm run dev" forwards /api. Defaults to http://localhost:4000.
VITE_DEV_API_URL=
