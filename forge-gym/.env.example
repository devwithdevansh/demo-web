# FORGE API settings. Copy this file to ".env" and fill it in.
# ".env" is git-ignored. Never commit real values, and never put them in src/.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Leave empty in local development to use a private database on this machine.
MONGODB_URI=

# Database name inside the cluster. Keep this set: on a cluster shared with
# other projects, a connection without a database name falls through to "test".
MONGODB_DB=gym

# Long random string used to sign sessions. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=4000
SESSION_HOURS=12
DEMO_SANDBOX_TTL_HOURS=24
DEMO_MAX_SANDBOXES=200
