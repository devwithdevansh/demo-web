{
  "name": "forge-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "npm --prefix forge-gym-backend run dev",
    "dev:web": "npm --prefix forge-website run dev",
    "dev:saas": "npm --prefix forge-saas run dev",
    "dev:admin": "npm --prefix forge-admin run dev",
    "dev:all": "npx concurrently -k -n api,web,saas,admin -c gray,cyan,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:saas\" \"npm:dev:admin\""
  }
}
